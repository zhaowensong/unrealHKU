{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://telecomtwin.local/schemas/central-pedestrian-source-v1.schema.json",
  "title": "TelecomTwin Central pedestrian topology source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "build_id",
    "generator",
    "source",
    "bounds_wgs84",
    "grid",
    "cells",
    "features",
    "manual_corrections",
    "audit",
    "hashes"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "dataset_id": { "$ref": "#/$defs/stableId" },
    "build_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "TelecomTwin Central OSM pipeline" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "attribution",
        "license",
        "overpass_url",
        "query",
        "query_sha256",
        "raw_sha256",
        "input_mode",
        "osm_base_timestamp"
      ],
      "properties": {
        "provider": { "const": "OpenStreetMap" },
        "attribution": { "const": "© OpenStreetMap contributors" },
        "license": { "const": "ODbL-1.0" },
        "overpass_url": { "type": "string", "format": "uri" },
        "query": { "type": "string", "minLength": 1 },
        "query_sha256": { "$ref": "#/$defs/sha256" },
        "raw_sha256": { "$ref": "#/$defs/sha256" },
        "input_mode": { "enum": ["overpass", "file", "fixture"] },
        "osm_base_timestamp": { "type": ["string", "null"] }
      }
    },
    "bounds_wgs84": { "$ref": "#/$defs/bbox" },
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns", "rows", "cell_order"],
      "properties": {
        "columns": { "const": 3 },
        "rows": { "const": 2 },
        "cell_order": { "const": "south-to-north, west-to-east" }
      }
    },
    "cells": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cell_id", "grid_coordinate", "bounds_wgs84", "source_feature_ids"],
        "properties": {
          "cell_id": { "$ref": "#/$defs/cellId" },
          "grid_coordinate": {
            "type": "array",
            "prefixItems": [
              { "type": "integer", "minimum": 0, "maximum": 2 },
              { "type": "integer", "minimum": 0, "maximum": 1 }
            ],
            "minItems": 2,
            "maxItems": 2
          },
          "bounds_wgs84": { "$ref": "#/$defs/bbox" },
          "source_feature_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/stableId" }
          }
        }
      }
    },
    "features": {
      "type": "array",
      "items": { "$ref": "#/$defs/feature" }
    },
    "manual_corrections": {
      "type": "array",
      "items": { "$ref": "#/$defs/correction" }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_element_count",
        "raw_way_count",
        "raw_node_count",
        "accepted_parent_feature_count",
        "output_feature_part_count",
        "rejected_parent_feature_count",
        "manual_review_feature_part_count",
        "total_source_length_m",
        "coarse_connected_component_count",
        "classification_counts",
        "cell_feature_counts",
        "decision_counts",
        "manual_correction_counts",
        "rejected_examples"
      ],
      "properties": {
        "raw_element_count": { "type": "integer", "minimum": 0 },
        "raw_way_count": { "type": "integer", "minimum": 0 },
        "raw_node_count": { "type": "integer", "minimum": 0 },
        "accepted_parent_feature_count": { "type": "integer", "minimum": 0 },
        "output_feature_part_count": { "type": "integer", "minimum": 0 },
        "rejected_parent_feature_count": { "type": "integer", "minimum": 0 },
        "manual_review_feature_part_count": { "type": "integer", "minimum": 0 },
        "total_source_length_m": { "type": "number", "minimum": 0 },
        "coarse_connected_component_count": { "type": "integer", "minimum": 0 },
        "classification_counts": { "$ref": "#/$defs/countMap" },
        "cell_feature_counts": { "$ref": "#/$defs/countMap" },
        "decision_counts": { "$ref": "#/$defs/countMap" },
        "manual_correction_counts": { "$ref": "#/$defs/countMap" },
        "rejected_examples": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["origin_id", "reason"],
            "properties": {
              "origin_id": { "$ref": "#/$defs/stableId" },
              "reason": { "$ref": "#/$defs/stableId" }
            }
          }
        }
      }
    },
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "topology_sha256", "document_sha256"],
      "properties": {
        "algorithm": { "const": "SHA-256" },
        "topology_sha256": { "$ref": "#/$defs/sha256" },
        "document_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "minLength": 1,
      "maxLength": 160
    },
    "cellId": {
      "type": "string",
      "pattern": "^central-r[01]-c[012]$"
    },
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["south", "west", "north", "east"],
      "properties": {
        "south": { "type": "number", "minimum": -90, "maximum": 90 },
        "west": { "type": "number", "minimum": -180, "maximum": 180 },
        "north": { "type": "number", "minimum": -90, "maximum": 90 },
        "east": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["point_id", "longitude", "latitude", "osm_node_id", "is_cell_boundary"],
      "properties": {
        "point_id": { "$ref": "#/$defs/stableId" },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "osm_node_id": { "type": ["integer", "null"], "minimum": 1 },
        "is_cell_boundary": { "type": "boolean" }
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "element_type", "element_id", "version"],
      "properties": {
        "provider": { "enum": ["OpenStreetMap", "manual-correction"] },
        "element_type": { "enum": ["way", "manual-polyline"] },
        "element_id": { "type": ["integer", "string"] },
        "version": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature_id",
        "parent_feature_id",
        "origin",
        "classification",
        "admission_rule",
        "requires_manual_review",
        "cell_id",
        "part_index",
        "directionality",
        "points",
        "tags",
        "geometry_sha256"
      ],
      "properties": {
        "feature_id": { "$ref": "#/$defs/stableId" },
        "parent_feature_id": { "$ref": "#/$defs/stableId" },
        "origin": { "$ref": "#/$defs/origin" },
        "classification": {
          "enum": ["sidewalk", "footway", "crossing", "pedestrian-zone", "manual-pedestrian-link"]
        },
        "admission_rule": { "$ref": "#/$defs/stableId" },
        "requires_manual_review": { "type": "boolean" },
        "cell_id": { "$ref": "#/$defs/cellId" },
        "part_index": { "type": "integer", "minimum": 0 },
        "directionality": { "enum": ["bidirectional", "forward", "reverse"] },
        "points": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/point" }
        },
        "tags": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "geometry_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "correction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["correction_id", "operation", "review_status", "reason"],
      "properties": {
        "correction_id": { "$ref": "#/$defs/stableId" },
        "operation": { "enum": ["add", "exclude", "reclassify"] },
        "review_status": { "enum": ["pending", "accepted", "rejected"] },
        "reason": { "type": "string", "minLength": 1 },
        "target_parent_feature_id": { "$ref": "#/$defs/stableId" },
        "classification": {
          "enum": ["sidewalk", "footway", "crossing", "pedestrian-zone", "manual-pedestrian-link"]
        },
        "points_wgs84": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "prefixItems": [
              { "type": "number", "minimum": -180, "maximum": 180 },
              { "type": "number", "minimum": -90, "maximum": 90 }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "operation": { "const": "add" } } },
          "then": { "required": ["classification", "points_wgs84"] }
        },
        {
          "if": { "properties": { "operation": { "enum": ["exclude", "reclassify"] } } },
          "then": { "required": ["target_parent_feature_id"] }
        },
        {
          "if": { "properties": { "operation": { "const": "reclassify" } } },
          "then": { "required": ["classification"] }
        }
      ]
    },
    "countMap": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    }
  }
}
